{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aureus Launcher",
  "version": "0.3.7",
  "identifier": "dev.aureus.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aureus Launcher",
        "width": 1060,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://api.modrinth.com https://meta.fabricmc.net https://piston-meta.mojang.com https://resources.download.minecraft.net https://libraries.minecraft.net https://api.adoptium.net https://cdn.modrinth.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2Nzg0NjFDN0Y4MDkwQTEKUldTaGtJQi9IRVo0Vm05UmZoenBCQWRjcnhuTFk2c0cybENLR25EY1lTNlNUMWF4OTVGREFCdksK",
      "endpoints": [
        "https://github.com/jjfrancoms/aureus-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
